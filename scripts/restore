#!/bin/bash

# Keep this path for calling _common.sh inside the execution's context of
# backup and restore scripts.
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# RE-ADD REPOSITORIES & REINSTALL ZAMMAD
#=================================================
# This mirrors the system-setup portion of scripts/install (repos, Elasticsearch
# with a capped heap, then the Zammad package). The application data itself is
# NOT recreated here — it comes back from the archive further down.
ynh_script_progression "Reinstalling Zammad..."

debian_version=$(lsb_release -sr | cut -d. -f1)

ynh_apt_install_dependencies curl apt-transport-https gnupg libimlib2

# Zammad apt repository
mkdir -p /etc/apt/keyrings
curl -fsSL "https://dl.packager.io/srv/zammad/zammad/key" \
    | gpg --dearmor \
    | tee /etc/apt/keyrings/pkgr-zammad.gpg > /dev/null
chmod 644 /etc/apt/keyrings/pkgr-zammad.gpg
echo "deb [signed-by=/etc/apt/keyrings/pkgr-zammad.gpg] https://dl.packager.io/srv/deb/zammad/zammad/stable/debian ${debian_version} main" \
    > /etc/apt/sources.list.d/zammad.list

# Elasticsearch repository (Zammad package hard-depends on it)
curl -fsSL "https://artifacts.elastic.co/GPG-KEY-elasticsearch" \
    | gpg --dearmor \
    | tee /etc/apt/keyrings/elasticsearch.gpg > /dev/null
chmod 644 /etc/apt/keyrings/elasticsearch.gpg
echo "deb [signed-by=/etc/apt/keyrings/elasticsearch.gpg] https://artifacts.elastic.co/packages/8.x/apt stable main" \
    > /etc/apt/sources.list.d/elasticsearch.list

apt-get update -qq

# Install Elasticsearch first, with a capped heap (see scripts/install).
ynh_script_progression "Installing Elasticsearch..."
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends elasticsearch 2>&1
mkdir -p /etc/elasticsearch/jvm.options.d
printf -- '-Xms512m\n-Xmx512m\n' > /etc/elasticsearch/jvm.options.d/yunohost.options
systemctl daemon-reload
systemctl enable elasticsearch --quiet
systemctl start elasticsearch || ynh_die "Elasticsearch failed to start. Check: journalctl -xeu elasticsearch.service"

# Pre-create a dummy nginx config so Zammad's postinst doesn't generate one that
# YunoHost would see as a conflicting app on the domain.
mkdir -p /etc/nginx/conf.d
touch /etc/nginx/conf.d/zammad.conf

ynh_script_progression "Installing the Zammad package (this may take several minutes)..."
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends zammad 2>&1

# Stop services before restoring data (and clean up the dummy nginx config and
# any config the postinst wrote — YunoHost manages NGINX).
for svc in zammad-websocket zammad-worker zammad-web zammad; do
    systemctl stop "$svc" 2>/dev/null || true
done
for svc in $(systemctl list-units 'zammad-*.service' --no-legend 2>/dev/null | awk '{print $1}'); do
    systemctl stop "$svc" 2>/dev/null || true
done
rm -f /etc/nginx/conf.d/zammad.conf /etc/nginx/sites-enabled/zammad.conf /etc/nginx/sites-available/zammad.conf
rm -rf /etc/nginx/conf.d/zammad.*.d/
# Wait for Zammad processes to exit, then wipe the bootsnap cache best-effort
# (a concurrent writer makes rm race with ENOTEMPTY; see scripts/install).
for _ in $(seq 1 15); do
    pgrep -u zammad >/dev/null 2>&1 || break
    sleep 1
done
rm -rf /opt/zammad/tmp/cache/ 2>/dev/null || true

#=================================================
# RESTORE APPLICATION CONFIGURATION
#=================================================
ynh_script_progression "Restoring application configuration..."

ynh_restore "/etc/zammad"

#=================================================
# RESTORE DATABASE + ATTACHMENTS
#=================================================
ynh_script_progression "Restoring the Zammad database and attachments..."

ynh_restore "/tmp/zammad_backup"

if [ -x /opt/zammad/contrib/backup/zammad_restore.sh ] \
   && ls /tmp/zammad_backup/*_zammad_db.psql.gz 1>/dev/null 2>&1; then
    # Zammad's own restore script replays both the DB dump and the attachments.
    BACKUP_DIR="/tmp/zammad_backup" \
        sudo -u zammad bash /opt/zammad/contrib/backup/zammad_restore.sh 2>&1 || true
elif ls /tmp/zammad_backup/*.sql.gz 1>/dev/null 2>&1; then
    # Fallback: restore the raw pg_dump taken by scripts/backup.
    dump_file=$(ls /tmp/zammad_backup/*.sql.gz | head -1)
    sudo -u postgres psql -c "DROP DATABASE IF EXISTS zammad;"
    sudo -u postgres psql -c "CREATE DATABASE zammad OWNER zammad;"
    zcat "$dump_file" | sudo -u postgres psql zammad
else
    ynh_print_warn "No database dump found in the archive — Zammad may start empty."
fi

#=================================================
# RESTORE NGINX CONFIGURATION
#=================================================
ynh_script_progression "Restoring NGINX configuration..."

ynh_restore "/etc/nginx/conf.d/$app.conf"
ynh_systemctl --service=nginx --action=reload

#=================================================
# RESTORE LOGROTATE & FAIL2BAN
#=================================================
ynh_script_progression "Restoring logrotate and fail2ban configuration..."

ynh_restore "/etc/logrotate.d/$app"
# install always runs ynh_config_add_fail2ban, so both files are in the archive.
ynh_restore "/etc/fail2ban/jail.d/$app.conf"
ynh_restore "/etc/fail2ban/filter.d/$app.conf"
systemctl reload fail2ban 2>/dev/null || true

#=================================================
# START SERVICES & RE-REGISTER WITH YUNOHOST
#=================================================
ynh_script_progression "Starting Zammad services..."

systemctl enable zammad --quiet 2>/dev/null || true
systemctl start zammad

yunohost service add zammad \
    --description="Zammad helpdesk and ticketing system" \
    --log="/var/log/zammad/production.log"

ynh_script_progression "Restoration of Zammad complete!"
