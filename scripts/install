#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# SYSTEM DEPENDENCIES & REPO
#=================================================
ynh_script_progression "Adding Zammad repository..."

# Prerequisites for adding the Zammad/Elasticsearch apt repositories. These are
# tracked as the app's dependencies (a '$app-ynh-deps' metapackage) so the core
# removes them cleanly on app removal. The 'restore' script installs the same
# set, so both paths stay in sync.
ynh_apt_install_dependencies curl apt-transport-https gnupg libimlib2

# Detect Debian version number (e.g. 12 for bookworm) — packager.io uses numbers, not codenames
debian_version=$(lsb_release -sr | cut -d. -f1)

# Add Zammad GPG key
mkdir -p /etc/apt/keyrings
curl -fsSL "https://dl.packager.io/srv/zammad/zammad/key" \
    | gpg --dearmor \
    | tee /etc/apt/keyrings/pkgr-zammad.gpg > /dev/null
chmod 644 /etc/apt/keyrings/pkgr-zammad.gpg

# Add Zammad apt repository
echo "deb [signed-by=/etc/apt/keyrings/pkgr-zammad.gpg] https://dl.packager.io/srv/deb/zammad/zammad/stable/debian ${debian_version} main" \
    > /etc/apt/sources.list.d/zammad.list

# Add Elasticsearch repository (Zammad package hard-depends on it)
curl -fsSL "https://artifacts.elastic.co/GPG-KEY-elasticsearch" \
    | gpg --dearmor \
    | tee /etc/apt/keyrings/elasticsearch.gpg > /dev/null
chmod 644 /etc/apt/keyrings/elasticsearch.gpg
echo "deb [signed-by=/etc/apt/keyrings/elasticsearch.gpg] https://artifacts.elastic.co/packages/8.x/apt stable main" \
    > /etc/apt/sources.list.d/elasticsearch.list

apt-get update -qq

#=================================================
# INSTALL ELASTICSEARCH FIRST
#=================================================
ynh_script_progression "Installing Elasticsearch..."

# Install Elasticsearch before Zammad so Zammad's package finds the dependency
# already satisfied and skips its own Elasticsearch setup steps.
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends elasticsearch 2>&1

# Cap the JVM heap AFTER installation so we don't interfere with the postinst
# security auto-configuration.  Default ES 8.x uses half of system RAM; on a
# memory-constrained VPS that leaves too little for dpkg to extract the large
# Zammad package (~2 GB of files).
mkdir -p /etc/elasticsearch/jvm.options.d
printf -- '-Xms512m\n-Xmx512m\n' > /etc/elasticsearch/jvm.options.d/yunohost.options

# ES postinst explicitly says "NOT starting on installation; run daemon-reload first"
systemctl daemon-reload
systemctl enable elasticsearch --quiet
systemctl start elasticsearch || {
    ynh_print_warn "Elasticsearch failed to start — dumping last 30 log lines:"
    journalctl -u elasticsearch -n 30 --no-pager 2>/dev/null || true
    ynh_die "Elasticsearch failed to start. Check: journalctl -xeu elasticsearch.service"
}

ynh_script_progression "Waiting for Elasticsearch to be ready..."
es_timeout=300
es_elapsed=0
until systemctl is-active --quiet elasticsearch; do
    sleep 5
    es_elapsed=$((es_elapsed + 5))
    if [ "$es_elapsed" -ge "$es_timeout" ]; then
        ynh_die "Elasticsearch did not become active within ${es_timeout}s. Check: journalctl -u elasticsearch -n 50"
    fi
done
# Give Elasticsearch a moment to finish binding its port after becoming active
sleep 10

#=================================================
# INSTALL ZAMMAD PACKAGE
#=================================================
ynh_script_progression "Installing Zammad (this may take several minutes)..."

# Pre-create a dummy nginx config so Zammad's postinst doesn't generate one
# that YunoHost would detect as a conflicting app on the domain.
mkdir -p /etc/nginx/conf.d
touch /etc/nginx/conf.d/zammad.conf

# Zammad's package installs PostgreSQL, Redis, and configures them automatically.
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends zammad 2>&1

#=================================================
# STOP POSTINST-STARTED SERVICES & CLEAN STATE
#=================================================
# The Zammad postinst automatically starts services the moment the package is
# installed — BEFORE our nginx config, settings, and DB are fully ready.
# Those premature service starts can also poison the bootsnap cache
# (Ruby's require cache) with "file not found" entries, causing subsequent
# starts to fail with Bundler::GemRequireError even though the file is on disk.
# Fix: stop all Zammad services, wipe the bootsnap cache, reset failed units,
# then start everything fresh after the rest of the install is complete.

ynh_script_progression "Resetting Zammad service state after installation..."

systemctl stop zammad 2>/dev/null || true
# Also stop any scaled instances (zammad-web-1, zammad-worker-1, etc.)
for svc in $(systemctl list-units 'zammad-*.service' --no-legend 2>/dev/null | awk '{print $1}'); do
    systemctl stop "$svc" 2>/dev/null || true
done

# Wait for the Zammad processes to actually exit before touching the bootsnap
# cache. A worker still running recreates files mid-delete, which makes the wipe
# race and fail with ENOTEMPTY — and that non-zero exit would abort the install.
for _ in $(seq 1 15); do
    pgrep -u zammad >/dev/null 2>&1 || break
    sleep 1
done

# Wipe bootsnap cache — stale "not found" entries survive service restarts.
# Best-effort: tolerate a lingering concurrent writer rather than aborting.
rm -rf /opt/zammad/tmp/cache/ 2>/dev/null || true

# Reset failed state so units can be started again
for svc in $(systemctl list-units 'zammad*.service' --all --no-legend 2>/dev/null | awk '{print $1}'); do
    systemctl reset-failed "$svc" 2>/dev/null || true
done

#=================================================
# DISABLE ZAMMAD'S OWN NGINX CONFIG
#=================================================
ynh_script_progression "Configuring NGINX..."

# Remove whatever Zammad's postinst wrote — YunoHost manages NGINX instead.
rm -f /etc/nginx/conf.d/zammad.conf
rm -f /etc/nginx/sites-enabled/zammad.conf
rm -f /etc/nginx/sites-available/zammad.conf
# Also remove any domain-specific conf dirs Zammad may have created
rm -rf /etc/nginx/conf.d/zammad.*.d/

# Deploy YunoHost NGINX config
ynh_config_add_nginx

#=================================================
# WAIT FOR ZAMMAD TO BE READY
#=================================================
# The zammad package postinst already started zammad.service.
# zammad-web.service is a placeholder (sleep infinity) — the real web
# server runs under zammad.service. Do NOT restart — first start runs
# DB migrations. Just enable and wait for the HTTP port.

systemctl enable zammad --quiet 2>/dev/null || true

# Start Zammad cleanly — we stopped it above to prevent the bootsnap cache
# from being poisoned by premature service starts inside the postinst.
# DB migrations and seed run on this first start; that takes several minutes.
systemctl start zammad

# zammad.service and zammad-web.service are placeholders (sleep infinity).
# The real Puma web server runs as zammad-web-1.service (scaled instance).
# Wait for it to become active, then poll the HTTP port.
ynh_script_progression "Waiting for Zammad web server on port $port (DB migrations on first start — allow up to 15 minutes)..."

timeout=900
elapsed=0
while ! curl -sf -o /dev/null "http://127.0.0.1:$port/"; do
    sleep 10
    elapsed=$((elapsed + 10))
    if [ $((elapsed % 60)) -eq 0 ]; then
        web1_status=$(systemctl is-active zammad-web-1 2>/dev/null || echo unknown)
        worker1_status=$(systemctl is-active zammad-worker-1 2>/dev/null || echo unknown)
        ynh_print_info "Still waiting... ${elapsed}s elapsed. web-1: ${web1_status} worker-1: ${worker1_status}"
        ynh_print_info "Recent log: $(journalctl -u zammad-web-1 -n 2 --no-pager 2>/dev/null | tail -1)"
    fi
    if [ "$elapsed" -ge "$timeout" ]; then
        ynh_print_warn "Check: journalctl -u zammad-web-1 -n 100 --no-pager"
        ynh_print_warn "Check: journalctl -u zammad-worker-1 -n 100 --no-pager"
        ynh_print_warn "Check: tail -50 /var/log/zammad/production.log"
        ynh_die "Zammad did not respond on port $port after ${timeout}s."
    fi
done

#=================================================
# INITIAL APPLICATION CONFIGURATION
#=================================================
ynh_script_progression "Configuring Zammad application settings..."

# Set the application URL so Zammad generates correct links. Zammad stores this
# in the database, so we drive it through the shared zammad_rails helper
# (defined in _common.sh), which runs the snippet via a private 0600 temp file.
zammad_rails "Setting.set('http_type', 'https'); Setting.set('fqdn', '${domain}')"

# Set the interface language
zammad_rails "Setting.set('locale_default', '${language}')"

#=================================================
# CREATE ADMIN USER
#=================================================
ynh_script_progression "Creating admin user..."

admin_email=$(ynh_user_get_info --username="$admin" --key="mail")
admin_password=$(ynh_string_random --length=24)

# Store password in YunoHost settings so it can be retrieved later
ynh_app_setting_set --key=admin_password --value="$admin_password"

zammad_rails "
u = User.where(login: '${admin}').first_or_initialize
u.login      = '${admin}'
u.firstname  = User.find_by(email: '${admin_email}')&.firstname || '${admin}'
u.lastname   = ''
u.email      = '${admin_email}'
u.password   = '${admin_password}'
u.roles      = Role.where(name: ['Admin', 'Agent'])
u.active     = true
u.created_by_id = 1
u.updated_by_id = 1
u.save!
"

# Mark setup wizard as complete — we've already configured everything the wizard
# would do (admin user, FQDN, http_type, language).  Without this, Zammad 7.0.1+
# leaves system_init_done=false and the frontend calls /api/v1/getting_started
# unauthenticated, which the security-hardened endpoint rejects with 403.
zammad_rails "Setting.set('system_init_done', true)"

#=================================================
# LDAP CONFIGURATION
#=================================================
ynh_script_progression "Configuring LDAP integration with YunoHost..."

# Wire Zammad to YunoHost's LDAP directory so users sign in with their YunoHost
# accounts. Configuration lives in an LdapSource row (everything goes in the
# serialized 'preferences' store — top-level setters like 'host=' do NOT exist),
# and the feature is gated by the 'ldap_integration' setting. Once both are in
# place, Zammad's Import::Ldap backend (listed in the 'import_backends' setting)
# syncs users automatically on its schedule. Keys/shape verified against
# upstream: spec/factories/ldap_source.rb and db/seeds/settings.rb.
#
# Anonymous bind is used (bind_user/bind_pw empty): YunoHost's slapd allows
# anonymous reads of the users subtree. Group->role mapping is left empty, so
# synced users receive the default signup role (Customer); an admin can refine
# roles and bind credentials under Settings > System > Integrations > LDAP.
#
# Output is captured to a log so that, if the directory is unreachable at
# install time, the background sync's diagnostics don't abort the install.
zammad_rails "
Setting.set('ldap_integration', true)
source = LdapSource.find_or_initialize_by(name: 'YunoHost')
source.preferences = {
  'host'             => 'localhost',
  'port'             => 389,
  'ssl'              => 'off',
  'ssl_verify'       => false,
  'options'          => { 'dc=yunohost,dc=org' => 'dc=yunohost,dc=org' },
  'option'           => 'dc=yunohost,dc=org',
  'base_dn'          => 'ou=users,dc=yunohost,dc=org',
  'bind_user'        => '',
  'bind_pw'          => '',
  'user_uid'         => 'uid',
  'user_filter'      => '(objectClass=posixAccount)',
  'group_uid'        => 'dn',
  'group_filter'     => '(objectClass=posixGroup)',
  'user_attributes'  => {
    'uid'       => 'login',
    'mail'      => 'email',
    'givenname' => 'firstname',
    'sn'        => 'lastname',
  },
  'group_role_map'   => {},
  'unassigned_users' => 'sigup_roles'
}
source.active = true
source.created_by_id = 1
source.updated_by_id = 1
source.save!
" > /var/log/$app/ldap-setup.log 2>&1 \
    || ynh_print_warn "LDAP auto-configuration did not complete — review /var/log/$app/ldap-setup.log and finish setup in Settings > System > Integrations > LDAP."

#=================================================
# FAIL2BAN
#=================================================
ynh_script_progression "Configuring Fail2ban..."
ynh_config_add_fail2ban --logpath="/var/log/zammad/production.log" \
    --failregex="Failed login for .* from <HOST>"

#=================================================
# LOGROTATE
#=================================================
ynh_config_add_logrotate "/var/log/zammad"

#=================================================
# REGISTER ZAMMAD WITH YUNOHOST
#=================================================
# Expose Zammad's umbrella service in the YunoHost webadmin (status + logs).
ynh_script_progression "Registering the Zammad service with YunoHost..."

yunohost service add zammad \
    --description="Zammad helpdesk and ticketing system" \
    --log="/var/log/zammad/production.log"

#=================================================
# FINISH
#=================================================
ynh_script_progression "Installation of Zammad complete!"
